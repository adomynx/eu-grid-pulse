	partition dim_country = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "dim_country.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Headers, {{"country_key", type text}, {"country_code", type text}, {"country_name", type text}, {"bidding_zone", type text}})
				in
					Typed

