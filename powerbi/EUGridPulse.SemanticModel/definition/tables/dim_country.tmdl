table dim_country
	lineageTag: c3cd7b45-8640-4b8c-9697-59ec37599d99

	column country_key
		dataType: string
		lineageTag: cdd90fb7-2955-4775-b166-8328bcfa31bc
		summarizeBy: none
		sourceColumn: country_key

	column country_code
		dataType: string
		lineageTag: d45f7cfb-bf2d-45e9-9236-d6bd236bd30a
		summarizeBy: none
		sourceColumn: country_code

	column country_name
		dataType: string
		lineageTag: 8ea9c082-cf43-4c18-988f-973d902aed3e
		summarizeBy: none
		sourceColumn: country_name

	column bidding_zone
		dataType: string
		lineageTag: a20cb4a1-a2a6-4d57-b608-aaf53d6964c2
		summarizeBy: none
