# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# ENTSO-E Transparency API security token (free — request via the Transparency Platform).
# Leave blank to run on the built-in synthetic data generator (no token needed).
ENTSOE_TOKEN=

# Force synthetic mode even when a token is set (handy for offline dev / CI):
# EU_GRID_PULSE_SYNTH=1

# Optional: override the DuckDB warehouse path (default: data/eu_grid_pulse.duckdb)
# DUCKDB_PATH=
