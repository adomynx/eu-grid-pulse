# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# ENTSO-E Transparency API security token (request from your account settings)
ENTSOE_TOKEN=

# --- Postgres route (default) ---
DATABASE_URL=postgresql+psycopg2://grid:grid@localhost:5432/eu_grid_pulse

# --- BigQuery route (uncomment if you switch warehouses) ---
# GCP_PROJECT=
# BQ_DATASET_RAW=raw
# BQ_DATASET_STAGING=staging
# BQ_DATASET_MARTS=marts
